# Copy this file to .env and fill in your actual values

# Database Configuration (auto-configured in docker-compose, but needed for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semrush_scraper

# SEMrush Credentials
# IMPORTANT: 2FA must be disabled on your SEMrush account for automation to work
SEMRUSH_EMAIL=your-email@example.com
SEMRUSH_PASSWORD=your-password-here

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Storage Configuration
# Get credentials from: https://console.cloud.google.com/iam-admin/serviceaccounts
GCS_BUCKET_NAME=your-bucket-name
GCS_PROJECT_ID=your-gcp-project-id

# Session Secret (generate a random string)
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Application Port (default: 5000)
PORT=5000
